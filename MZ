-- 👻 FREECAM SYSTEM
-- ═══════════════════════════════════════════
local freecam = {
    enabled = false,
    speed = 100,
    camPos = Vector3.new(0, 0, 0),
    camYaw = 0,
    camPitch = 0,
    savedCFrame = nil,
    keys = {},
    joyMove = Vector2.new(0, 0),
    upPressed = false,
    downPressed = false,
    lookSens = 0.008,
}

local function startFreecam()
    if freecam.enabled then return end
    freecam.enabled = true
    freecam.savedCFrame = CM.CFrame
    freecam.camPos = CM.CFrame.Position

    local look = CM.CFrame.LookVector
    freecam.camYaw = math.atan2(-look.X, -look.Z)
    freecam.camPitch = math.asin(math.clamp(look.Y, -1, 1))

    CM.CameraType = Enum.CameraType.Scriptable
    CM.CameraSubject = nil

    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end
    print("👻 Freecam เปิด")
end

local function stopFreecam()
    if not freecam.enabled then return end
    freecam.enabled = false
    CM.CameraType = Enum.CameraType.Custom
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
        CM.CameraSubject = hum
    end
    print("👻 Freecam ปิด")
end

-- PC Keyboard
U.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not freecam.enabled then return end
    freecam.keys[input.KeyCode] = true
end)
U.InputEnded:Connect(function(input)
    freecam.keys[input.KeyCode] = false
end)

-- PC Mouse Look (Right Click)
local mouseLook = false
U.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not freecam.enabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseLook = true
    end
end)
U.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseLook = false
    end
end)
U.InputChanged:Connect(function(input)
    if not freecam.enabled or not mouseLook then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local sens = 0.005
        freecam.camPitch = math.clamp(
            freecam.camPitch - input.Delta.Y * sens,
            -math.rad(85),
            math.rad(85)
        )
        freecam.camYaw = freecam.camYaw - input.Delta.X * sens
    end
end)

