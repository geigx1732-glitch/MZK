    local lookTouch = nil
    local lastTouchPos = nil

    lookArea.InputBegan:Connect(function(input)
        if not freecam.enabled then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            lookTouch = input
            lastTouchPos = input.Position
        end
    end)

    lookArea.InputChanged:Connect(function(input)
        if not freecam.enabled then return end
        if input.UserInputType ~= Enum.UserInputType.Touch then return end
        if input ~= lookTouch then return end
        if not lastTouchPos then return end

        local delta = input.Position - lastTouchPos
        lastTouchPos = input.Position

        freecam.camPitch = math.clamp(
            freecam.camPitch - delta.Y * freecam.lookSens,
            -math.rad(85),
            math.rad(85)
        )
        freecam.camYaw = freecam.camYaw - delta.X * freecam.lookSens
    end)

    lookArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            if input == lookTouch then
                lookTouch = nil
                lastTouchPos = nil
            end
        end
    end)
end

-- Freecam Main Loop
R.RenderStepped:Connect(function(dt)
    if not freecam.enabled then return end

    local rotCF = CFrame.Angles(0, freecam.camYaw, 0) * CFrame.Angles(freecam.camPitch, 0, 0)
    local lookCF = CFrame.new(freecam.camPos) * rotCF

    local moveDir = Vector3.new(0, 0, 0)

    -- PC WASD
    if freecam.keys[Enum.KeyCode.W] then moveDir = moveDir + lookCF.LookVector end
    if freecam.keys[Enum.KeyCode.S] then moveDir = moveDir - lookCF.LookVector end
    if freecam.keys[Enum.KeyCode.A] then moveDir = moveDir - lookCF.RightVector end
    if freecam.keys[Enum.KeyCode.D] then moveDir = moveDir + lookCF.RightVector end
    if freecam.keys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if freecam.keys[Enum.KeyCode.LeftControl] then moveDir = moveDir - Vector3.new(0, 1, 0) end

    -- Mobile
    if isMobile then
        local jm = freecam.joyMove
        if math.abs(jm.X) > 0.05 or math.abs(jm.Y) > 0.05 then
            moveDir = moveDir + lookCF.LookVector * (-jm.Y)
            moveDir = moveDir + lookCF.RightVector * jm.X
        end
        if freecam.upPressed then
            moveDir = moveDir + Vector3.new(0, 1, 0)
        end
        if freecam.downPressed then
            moveDir = moveDir - Vector3.new(0, 1, 0)
        end
    end

    if moveDir.Magnitude > 0 then
        freecam.camPos = freecam.camPos + moveDir.Unit * freecam.speed * dt
    end

    CM.CFrame = CFrame.new(freecam.camPos) * rotCF
end)

